# Agnes IA - Configuration
# Copiez ce fichier en .env et configurez les valeurs

# ====================
# Redis
# ====================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ====================
# Supabase (pour le stockage des métadonnées)
# ====================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ====================
# Amazon S3 (pour le stockage des vidéos)
# ====================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=agnes-ia
S3_REGION=us-east-1

# ====================
# GPU Configuration
# ====================
MAX_VRAM=0.9
BATCH_SIZE_SD=4
BATCH_SIZE_UPSCALE=1
BATCH_SIZE_FACE=2
BATCH_SIZE_AUDIO=8

# ====================
# Rate Limiting
# ====================
RATE_LIMIT=100
RATE_LIMIT_PERIOD=60
BASE_DELAY=1.0
MAX_DELAY=3600.0

# ====================
# Stockage Local
# ====================
UPLOAD_DIR=/tmp/agnes_uploads
QUARANTINE_DIR=/tmp/agnes_quarantine
MAX_FILE_SIZE=2147483648  # 2GB

# ====================
# Sécurité
# ====================
CLAMAV_ENABLED=false
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# ====================
# Monitoring
# ====================
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000

# ====================
# API
# ====================
DEBUG=true
KEEP_TEMP_FILES=false

# ====================
# Clés API (pour l'authentification)
# ====================
# API_KEY_PREMIUM=your-premium-key
# API_KEY_ADMIN=your-admin-key
# API_KEY_FREE=your-free-key
